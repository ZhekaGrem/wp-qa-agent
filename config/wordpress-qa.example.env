# Required
QA_BASE_URL=https://staging.example.com
QA_ENVIRONMENT=staging
QA_ALLOW_WRITES=false
QA_ALLOW_UPDATES=false
QA_ALLOW_EMAIL=false
QA_ALLOW_PAYMENTS=false
QA_ALLOW_REFUNDS=false

# WP-CLI: local example: wp; SSH example: ssh qa@example.com -- wp
QA_WP_CLI=wp
QA_WP_PATH=/var/www/html

# Target & Source
QA_SOURCE_DIR=.
QA_PLUGIN_SLUG=

# Workflow Feature Toggles
QA_RUN_STATIC_ANALYSIS=true
QA_RUN_PHPUNIT=true
QA_RUN_INTEGRATION=true
QA_RUN_ACCESSIBILITY=true
QA_RUN_HTML_VALIDATION=true
QA_RUN_VISUAL=true
QA_RUN_PERFORMANCE=false
QA_RUN_PLUGIN_CHECK=false
QA_CLEANUP_FIXTURES=false

# Optional proof that this is staging/local
QA_EXPECTED_HOME=https://staging.example.com
QA_STAGING_MARKER=staging
QA_HEALTH_PATH=/
QA_LOGIN_PATH=/wp-login.php

# Optional test accounts; do not commit passwords
QA_ADMIN_USER=
QA_CUSTOMER_USER=
QA_TEST_EMAIL_DOMAIN=example.test
