{
  "name": "wp-qa-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WordPress QA Agent — modular guarded testing workflow with Playwright Test Agents & Deletion Guard Hooks",
  "scripts": {
    "test": "npx playwright test",
    "prepare": "node scripts/install-hooks.mjs",
    "qa:setup": "node scripts/validate-config.mjs && node scripts/install-hooks.mjs",
    "qa:fast": "node scripts/run-qa.mjs fast",
    "qa:update": "node scripts/run-qa.mjs update",
    "qa:full": "node scripts/run-qa.mjs full",
    "qa:plan": "node scripts/run-qa.mjs plan",
    "qa:html": "node scripts/run-qa.mjs html",
    "qa:cleanup": "node scripts/run-qa.mjs cleanup",
    "qa:hooks": "node scripts/install-hooks.mjs",
    "validate": "node scripts/validate-config.mjs",
    "playwright:install": "npx playwright install",
    "agents:init": "npx playwright init-agents"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.56.0",
    "@wordpress/e2e-test-utils-playwright": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
